  "rules": [
    {
      "code": "SUFFIX_IK_EK",
      "kidExplanation": "Скажи слово со словом «нет». Буква пропала — пиши {е}. Осталась — пиши {и}.",
      "steps": [
        "Скажи: нет мячика, нет овражка",
        "Буква осталась — пиши {и}",
        "Буква пропала — пиши {е}"
      ],
      "examples": [
        "мяч{и}к — нет мяч{и}ка",
        "овраж{е}к — нет овражка"
      ]
    },
    {
      "code": "SUFFIX_CUB",
      "kidExplanation": "Это детёныши. После ж, ч, ш, щ пиши {о} или {а}. После других букв — {ё} или {я}.",
      "steps": [
        "Посмотри на букву перед суффиксом",
        "Это ж, ч, ш или щ — пиши {о} или {а}",
        "Другая буква — пиши {ё} или {я}"
      ],
      "examples": [
        "еж{о}нок, зайч{а}та",
        "олен{ё}нок, ут{я}та"
      ]
    },
    {
      "code": "SUFFIX_DIM",
      "kidExplanation": "Это ласковые слова. Перед суффиксом твёрдый звук — пиши {о}. Мягкий — пиши {е}.",
      "steps": [
        "Найди ласковый суффикс",
        "Послушай звук перед ним",
        "Твёрдый — пиши {о}",
        "Мягкий — пиши {е}"
      ],
      "examples": [
        "берёз{о}нька, сказ{о}чка",
        "доч{е}нька, реч{е}нька"
      ]
    },
    {
      "code": "SUFFIX_CONST",
      "kidExplanation": "Некоторые суффиксы всегда пишутся одинаково: -{о}сть, -т{е}ль, -н{и}к, -{а}рь. Их надо просто запомнить.",
      "steps": [
        "Найди суффикс в конце слова",
        "Узнай его: -{о}сть, -т{е}ль, -н{и}к, -{а}рь",
        "Пиши его так же, как всегда"
      ],
      "examples": [
        "смел{о}сть, радость",
        "учит{е}ль, библиотек{а}рь"
      ]
    }
  ],
